{
  "name": "bing-wallpaper",
  "productName": "bing wallpaper",
  "description": "bing wallpaper",
  "keywords": [],
  "main": "./main.js",
  "version": "1.2.0",
  "author": "L",
  "repository": "https://github.com/ClDaniel1/bing",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "productName": "bingWallpaper",
    "appId": "com.l.bingWallpaper",
    "copyright": "L",
    "directories": {
      "output": "build"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "icon": "./icon.ico",
      "target": [
        {
          "target": "nsis"
        }
      ]
    }
  },
  "win": {
    "icon": "/icon.ico"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "node-schedule": "^2.1.1",
    "wallpaper": "^7.3.1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
